<Window x:Class="OpenTail.Bullshark.App.CodexModelPrompt"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="New Codex session"
        SizeToContent="WidthAndHeight" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource PromptBg}" Foreground="{DynamicResource PromptText}" FontFamily="Segoe UI">
    <Window.Resources>
        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Padding" Value="14,7" />
            <Setter Property="Margin" Value="0,0,8,0" />
        </Style>
        <!-- OK is the app's green launch button, as Start is on the resume screen. -->
        <Style x:Key="OkGo" TargetType="Button" BasedOn="{StaticResource GoButton}">
            <Setter Property="Padding" Value="20,7" />
            <Setter Property="Margin" Value="0,0,8,0" />
        </Style>

        <Style x:Key="Muted" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource PromptMuted}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </Window.Resources>

    <StackPanel Margin="20" Width="440">
        <TextBlock x:Name="Heading" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" />
        <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
            <TextBlock Text="Model" VerticalAlignment="Center" Margin="0,0,8,0" />
            <ComboBox x:Name="ModelBox" MinWidth="280" VerticalContentAlignment="Center"
                      AutomationProperties.Name="Model of the new Codex session" />
        </StackPanel>
        <TextBlock x:Name="ModelNote" Style="{StaticResource Muted}" Margin="0,6,0,0" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button x:Name="OkButton" Content="OK" Style="{StaticResource OkGo}" Click="Ok_Click" IsEnabled="False"
                    AutomationProperties.Name="OK" />
            <Button x:Name="CancelButton" Content="Cancel" IsCancel="True" IsDefault="True" Click="Cancel_Click" Margin="0" />
        </StackPanel>
    </StackPanel>
</Window>
