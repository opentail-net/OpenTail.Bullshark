<Window x:Class="OpenTail.Bullshark.App.CommandPaletteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Go to" Width="560" SizeToContent="Height"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource PalBg}" Foreground="{DynamicResource PalText}" FontFamily="Segoe UI"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Window.Resources>
        <!-- A full template, so the selected row takes the palette's colour in both themes and is not the system highlight. -->
        <Style TargetType="ListBoxItem">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Foreground" Value="{DynamicResource PalText}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Row" Background="Transparent" CornerRadius="3" Padding="{TemplateBinding Padding}">
                            <ContentPresenter Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Row" Property="Background" Value="{DynamicResource PalSelection}" />
                                <Setter Property="Foreground" Value="{DynamicResource PalSelectionText}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Border BorderBrush="{DynamicResource PalBorder}" BorderThickness="1" Background="{DynamicResource PalPanel}" Padding="10">
        <StackPanel>
            <TextBox x:Name="QueryBox" FontSize="15" Padding="8,6" BorderThickness="1"
                     Background="{DynamicResource PalBg}" Foreground="{DynamicResource PalText}"
                     BorderBrush="{DynamicResource PalBorder}" CaretBrush="{DynamicResource PalText}"
                     TextChanged="QueryBox_TextChanged" ToolTip="Type to filter. Up and Down move, Enter goes, Esc closes." />
            <TextBlock x:Name="NoMatch" Text="Nothing matches. Esc closes." Foreground="{DynamicResource PalMuted}"
                       Margin="4,10,4,4" Visibility="Collapsed" />
            <ListBox x:Name="Results" Margin="0,8,0,0" Background="Transparent" BorderThickness="0" Padding="0" MaxHeight="400"
                     IsTabStop="False" Focusable="False" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     MouseDoubleClick="Results_MouseDoubleClick">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Title}" FontSize="14" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="{Binding Hint}" FontSize="12" Foreground="{DynamicResource PalMuted}"
                                       Margin="16,0,0,0" MaxWidth="240" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </StackPanel>
    </Border>
</Window>
