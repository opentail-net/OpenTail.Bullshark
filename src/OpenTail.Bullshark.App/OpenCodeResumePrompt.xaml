<Window x:Class="OpenTail.Bullshark.App.OpenCodeResumePrompt"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        SizeToContent="WidthAndHeight" ResizeMode="CanResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource PromptBg}" Foreground="{DynamicResource PromptText}" FontFamily="Segoe UI">
    <Window.Resources>
        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Padding" Value="14,7" />
            <Setter Property="Margin" Value="0,0,8,0" />
        </Style>

        <!-- Make summary: its shape and its disabled look are the attention yellow of the other screens. -->
        <Style x:Key="YellowGo" TargetType="Button" BasedOn="{StaticResource GoButton}">
            <Setter Property="Background" Value="{DynamicResource PromptAttention}" />
            <Setter Property="Foreground" Value="{DynamicResource PromptAttentionText}" />
            <Setter Property="BorderBrush" Value="{DynamicResource PromptAttention}" />
            <Setter Property="Padding" Value="14,7" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="Ring" CornerRadius="9" BorderThickness="2" BorderBrush="Transparent" Margin="-2" />
                            <Border x:Name="Frame" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="{DynamicResource UiRadius}" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                                  TextElement.Foreground="{TemplateBinding Foreground}" />
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Frame" Property="Background" Value="{DynamicResource PromptAttentionHover}" />
                                <Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource PromptAttentionHover}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Frame" Property="Background" Value="{DynamicResource PromptAttentionPressed}" />
                                <Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource PromptAttentionPressed}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Ring" Property="BorderBrush" Value="{DynamicResource UiAccent}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource PromptText}" />
            <Setter Property="Margin" Value="0,0,0,6" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <StackPanel Orientation="Horizontal">
                            <Grid Width="14" Height="14" Margin="0,0,8,0" VerticalAlignment="Center">
                                <Ellipse Stroke="{DynamicResource PromptMuted}" StrokeThickness="1.4" />
                                <Ellipse x:Name="Dot" Width="6" Height="6" Fill="{DynamicResource PromptText}" Visibility="Collapsed" />
                            </Grid>
                            <ContentPresenter VerticalAlignment="Center" />
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Dot" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Section" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,14,0,6" />
        </Style>

        <Style x:Key="Muted" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource PromptMuted}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="20,20,20,0" Width="580">
                <TextBlock x:Name="Heading" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" />
                <TextBlock x:Name="Facts" Style="{StaticResource Muted}" Margin="0,6,0,0" />
                <TextBlock x:Name="FolderNotice" Foreground="{DynamicResource UiDanger}" TextWrapping="Wrap" Margin="0,8,0,0" Visibility="Collapsed" />

                <TextBlock Style="{StaticResource Section}" Text="How to continue" />
                <RadioButton x:Name="FullChoice" GroupName="OpenCodeResume" />
                <RadioButton x:Name="SummaryChoice" GroupName="OpenCodeResume" />

                <!-- The level row and Make summary: the summary is made only by its button (one model call, OC-O4). Enabled for the summary only. -->
                <StackPanel x:Name="LevelBlock" Margin="22,0,0,4">
                    <ComboBox x:Name="LevelBox" MinWidth="220" Margin="0,0,0,6" HorizontalAlignment="Left" VerticalContentAlignment="Center"
                              AutomationProperties.Name="Summary level" />
                    <Button x:Name="MakeSummaryButton" Content="Make summary" Click="MakeSummary_Click" IsEnabled="False"
                            HorizontalAlignment="Left" Margin="0,2,0,6" Style="{StaticResource YellowGo}"
                            ToolTip="Makes the summary now: one model call on your opencode login. Nothing is sent until you press it." AutomationProperties.Name="Make summary" />
                    <TextBlock Style="{StaticResource Muted}" Margin="0,0,0,4"
                               Text="opencode writes the summary from this session's messages. Tool calls and their output are left out." />
                </StackPanel>

                <!-- The tail (RS-D19): "Include last [N] turns", in Summary only. The summary covers the messages before these turns (RS-D20). -->
                <StackPanel x:Name="TailBlock" Margin="22,0,0,0">
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                        <CheckBox x:Name="TailBox" Content="Include last" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBox x:Name="TurnsBox" Width="56" Padding="6,3" VerticalContentAlignment="Center" />
                        <TextBlock Text="turns" VerticalAlignment="Center" Margin="8,0,0,0" />
                    </StackPanel>
                    <TextBlock Style="{StaticResource Muted}" Margin="0,2,0,0"
                               Text="Word for word, messages only, and at most about 4,000 tokens. The oldest turn goes first." />
                </StackPanel>

                <TextBlock x:Name="CostText" Style="{StaticResource Muted}" Margin="0,14,0,0" />

                <!-- The start text, shown before anything starts. Last turns only: hidden until a text is made, and hidden again when the choice changes. -->
                <StackPanel x:Name="PreviewBlock" Visibility="Collapsed" Margin="0,14,0,0">
                    <TextBlock x:Name="PreviewHeader" Style="{StaticResource Muted}" />
                    <TextBox x:Name="PreviewBox" IsReadOnly="True" TextWrapping="Wrap" FontFamily="Consolas" FontSize="12"
                             MaxHeight="260" VerticalScrollBarVisibility="Auto" Margin="0,6,0,0" Padding="8"
                             Background="{DynamicResource PromptPanel}" Foreground="{DynamicResource PromptText}"
                             BorderBrush="{DynamicResource PromptBorder}" />
                    <Button x:Name="CopyButton" Content="Copy" Click="Copy_Click" HorizontalAlignment="Left" Margin="0,6,0,0"
                            ToolTip="Copies the text above to the clipboard. Nothing is sent to a session." AutomationProperties.Name="Copy the start text" />
                    <TextBlock x:Name="PreviewNote" Style="{StaticResource Muted}" Margin="0,4,0,0" Visibility="Collapsed" />
                </StackPanel>

                <CheckBox x:Name="RememberBox" Content="Remember for this session" Foreground="{DynamicResource PromptText}" Margin="0,16,0,0" />
            </StackPanel>
        </ScrollViewer>
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="20,18,20,20">
            <Button x:Name="StartButton" Style="{StaticResource GoButton}" Padding="20,7" Margin="0,0,8,0" Click="Start_Click" />
            <Button x:Name="CancelButton" Content="Cancel" IsCancel="True" IsDefault="True" Click="Cancel_Click" Margin="0" />
        </StackPanel>
    </Grid>
</Window>
