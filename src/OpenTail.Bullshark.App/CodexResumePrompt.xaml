<Window x:Class="OpenTail.Bullshark.App.CodexResumePrompt"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Resume a Codex session"
        SizeToContent="WidthAndHeight" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource PromptBg}" Foreground="{DynamicResource PromptText}" FontFamily="Segoe UI">
    <Window.Resources>
        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Padding" Value="14,7" />
            <Setter Property="Margin" Value="0,0,8,0" />
        </Style>
        <!-- Start is the app's green launch button, as Claude's Resume is (the GoButton style, so the colours and the hover are the app's). -->
        <Style x:Key="StartGo" TargetType="Button" BasedOn="{StaticResource GoButton}">
            <Setter Property="Padding" Value="20,7" />
            <Setter Property="Margin" Value="0,0,8,0" />
        </Style>

        <Style TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource PromptText}" />
            <Setter Property="Margin" Value="0,0,0,6" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <StackPanel Orientation="Horizontal">
                            <Grid Width="14" Height="14" Margin="0,0,8,0" VerticalAlignment="Center">
                                <Ellipse Stroke="{DynamicResource PromptMuted}" StrokeThickness="1.4" />
                                <Ellipse x:Name="Dot" Width="6" Height="6" Fill="{DynamicResource PromptText}" Visibility="Collapsed" />
                            </Grid>
                            <ContentPresenter VerticalAlignment="Center" />
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Dot" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- A segment of a row of choices (the summary levels): the chosen one shows pressed. -->
        <Style x:Key="Segment" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource PromptText}" />
            <Setter Property="Margin" Value="0,0,6,6" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Frame" Background="{DynamicResource PromptPanel}"
                                BorderBrush="{DynamicResource PromptBorder}" BorderThickness="1" CornerRadius="3" Padding="10,4">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource PromptMuted}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Frame" Property="Background" Value="{DynamicResource PromptSelection}" />
                                <Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource PromptText}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Section" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,14,0,6" />
        </Style>

        <Style x:Key="Muted" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource PromptMuted}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </Window.Resources>

    <StackPanel Margin="20" Width="580">
        <TextBlock x:Name="Heading" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" />
        <TextBlock x:Name="Facts" Style="{StaticResource Muted}" Margin="0,6,0,0" />

        <TextBlock Style="{StaticResource Section}" Text="How to continue" />
        <RadioButton x:Name="FullChoice" GroupName="CodexResume" />
        <RadioButton x:Name="TailChoice" GroupName="CodexResume" IsChecked="True" />
        <RadioButton x:Name="SummaryChoice" GroupName="CodexResume" />

        <StackPanel x:Name="LevelBlock" Margin="22,0,0,4">
            <WrapPanel x:Name="LevelRow" Orientation="Horizontal" />
            <TextBlock Style="{StaticResource Muted}" Margin="0,0,0,4"
                       Text="Codex writes it from this session's messages. Tool calls and their output are left out." />
        </StackPanel>

        <StackPanel x:Name="TurnsBlock" Margin="22,0,0,0">
            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                <TextBlock Text="Keep the last" VerticalAlignment="Center" Margin="0,0,8,0" />
                <TextBox x:Name="TurnsBox" Width="56" Padding="6,3" VerticalContentAlignment="Center" />
                <TextBlock Text="turns" VerticalAlignment="Center" Margin="8,0,0,0" />
            </StackPanel>
            <TextBlock Style="{StaticResource Muted}" Margin="0,2,0,0"
                       Text="Word for word, messages only, and at most about 4,000 tokens. The oldest turn goes first." />
        </StackPanel>

        <TextBlock Style="{StaticResource Muted}" Margin="0,12,0,0"
                   Text="The new session starts with Codex's configured model. The model is not chosen here." />

        <TextBlock x:Name="CostText" Style="{StaticResource Muted}" Margin="0,14,0,0" />
        <Button x:Name="MakeSummaryButton" Content="Make summary" Click="MakeSummary_Click" HorizontalAlignment="Left" Margin="0,8,0,0"
                ToolTip="Makes the summary now (one Codex call) and keeps it for Start. Nothing else makes it." AutomationProperties.Name="Make summary" />

        <!-- The start text, shown before anything starts. Hidden until a text is made, and hidden again when the choice changes. -->
        <StackPanel x:Name="PreviewBlock" Visibility="Collapsed" Margin="0,14,0,0">
            <TextBlock x:Name="PreviewHeader" Style="{StaticResource Muted}" />
            <TextBox x:Name="PreviewBox" IsReadOnly="True" TextWrapping="Wrap" FontFamily="Consolas" FontSize="12"
                     MaxHeight="260" VerticalScrollBarVisibility="Auto" Margin="0,6,0,0" Padding="8"
                     Background="{DynamicResource PromptPanel}" Foreground="{DynamicResource PromptText}"
                     BorderBrush="{DynamicResource PromptBorder}" />
            <Button x:Name="CopyButton" Content="Copy" Click="Copy_Click" HorizontalAlignment="Left" Margin="0,6,0,0"
                    ToolTip="Copies the text above to the clipboard. Nothing is sent to a session." AutomationProperties.Name="Copy the start text" />
            <TextBlock x:Name="PreviewNote" Style="{StaticResource Muted}" Margin="0,4,0,0" Visibility="Collapsed" />
        </StackPanel>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button x:Name="StartButton" Content="Start" Style="{StaticResource StartGo}" Click="Start_Click"
                    AutomationProperties.Name="Start" />
            <Button x:Name="CancelButton" Content="Cancel" IsCancel="True" IsDefault="True" Click="Cancel_Click" Margin="0" />
        </StackPanel>
    </StackPanel>
</Window>
