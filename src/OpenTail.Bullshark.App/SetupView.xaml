<UserControl x:Class="OpenTail.Bullshark.App.SetupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource SetupBg}" Foreground="{DynamicResource SetupText}">
    <!-- The colours come from the rail's palette (ApplyTheme). Replacing a brush updates every control that uses it. The text boxes, the combo
         boxes and the tooltips are the app's own styles (Styles/Controls.xaml, P2-P4); this page keeps only what differs: its labels and its tabs. -->
    <UserControl.Resources>
        <SolidColorBrush x:Key="SetupBg" Color="#111316" />
        <SolidColorBrush x:Key="SetupPanel" Color="#0C0D10" />
        <SolidColorBrush x:Key="SetupText" Color="#E6E6E6" />
        <SolidColorBrush x:Key="SetupMuted" Color="#9AA3AE" />
        <SolidColorBrush x:Key="SetupBorder" Color="#2A2F38" />
        <SolidColorBrush x:Key="SetupSelection" Color="#2B3A4F" />

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource SetupText}" />
        </Style>

        <!-- A tab of the details area (Models, Preview): quiet text, with a line under the chosen one. -->
        <Style x:Key="DetailTab" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource SetupMuted}" />
            <Setter Property="Margin" Value="0,0,18,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Frame" Background="Transparent" BorderBrush="Transparent" BorderThickness="0,0,0,2" Padding="2,4,2,5">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource SetupText}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource SetupText}" />
                                <Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource SetupText}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Frame" Property="Background" Value="{DynamicResource SetupSelection}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- The small mark that holds an explanation. The text that used to sit on the page is in its hover text. -->
        <Style x:Key="Info" TargetType="TextBlock">
            <Setter Property="Text" Value="ⓘ" />
            <Setter Property="Foreground" Value="{DynamicResource SetupMuted}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Margin" Value="8,0,0,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Cursor" Value="Help" />
            <Setter Property="ToolTipService.InitialShowDelay" Value="150" />
            <Setter Property="ToolTipService.ShowDuration" Value="60000" />
        </Style>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource SetupText}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="Margin" Value="0,6,0,0" />
        </Style>

        <Style x:Key="RoleLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource SetupText}" />
            <Setter Property="Width" Value="84" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </UserControl.Resources>

    <!-- The page fits one screen (owner, 2026-11-16). The top holds what every run needs: the task, the folder and the pattern.
         The details below show models or an editable preview. Start is in a footer that never scrolls, with one line that says what
         would start. Explanations are hover texts on the small marks.
         The rows are in the order the page is read and Tabbed (P5, 2026-11-19): the top, the details, the models or the preview, and the footer
         last, so Tab goes through the fields and then to Start. Each row lists its controls left to right in the order they are declared. -->
    <Grid Background="{DynamicResource SetupBg}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- What every run needs. -->
        <Grid Grid.Row="0" Margin="20,14,20,0" MaxWidth="900" HorizontalAlignment="Left">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="70" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="Task" Style="{StaticResource FieldLabel}"
                       ToolTip="What the run should do. The planner plans it in small batches." />
            <TextBox Grid.Row="0" Grid.Column="1" x:Name="TaskBox" AcceptsReturn="True" TextWrapping="Wrap"
                     MinHeight="52" MaxHeight="110" VerticalScrollBarVisibility="Auto" Margin="0,0,0,10"
                     ToolTip="What the run should do. The planner plans it in small batches."
                     TextChanged="OnTextChanged" />

            <TextBlock Grid.Row="1" Text="Folder" Style="{StaticResource FieldLabel}"
                       ToolTip="The folder the sessions work in. A folder must be trusted in Claude before its sessions can start." />
            <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,0,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ComboBox x:Name="FolderBox" Grid.Column="0" IsEditable="True"
                              ToolTip="Trusted folders first, most recently used first. You can type a path." />
                    <Button x:Name="BrowseButton" Grid.Column="1" Content="Browse…" Margin="8,0,0,0"
                            ToolTip="Pick the folder from disk." Click="Browse_Click" />
                </Grid>
                <TextBlock x:Name="FolderMessage" TextWrapping="Wrap" Foreground="{DynamicResource SetupMuted}" FontSize="12"
                           Margin="0,3,0,0" />
            </StackPanel>

            <TextBlock Grid.Row="2" Text="Pattern" Style="{StaticResource FieldLabel}"
                       ToolTip="The shape of the run: how many sessions there are and who reports to whom." />
            <WrapPanel Grid.Row="2" Grid.Column="1" Margin="0,0,0,6">
                <ComboBox x:Name="PatternBox" MinWidth="220" Margin="0,0,12,4"
                          ToolTip="The shape of the run. Each pattern keeps its own settings."
                          SelectionChanged="PatternBox_SelectionChanged">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Title}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <StackPanel x:Name="CodersRow" Orientation="Horizontal" Margin="0,0,12,4">
                    <TextBlock Text="Coders" VerticalAlignment="Center" Margin="0,0,8,0"
                               ToolTip="How many coders work in parallel. Each takes its own batches from the planner." />
                    <ComboBox x:Name="CodersBox" Width="70" ToolTip="Two to six coders, for plan > many coders." SelectionChanged="OnSelectionChanged" />
                </StackPanel>
                <TextBlock x:Name="PatternDescription" TextWrapping="Wrap" Foreground="{DynamicResource SetupMuted}"
                           VerticalAlignment="Center" MaxWidth="520" Margin="0,0,0,4" />
            </WrapPanel>
        </Grid>

        <!-- The details: models and an editable preview of the generated briefs. -->
        <Border Grid.Row="1" Margin="20,8,20,0" BorderBrush="{DynamicResource SetupBorder}" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal">
                <RadioButton x:Name="ModelsTab" GroupName="SetupDetails" Content="Models" Style="{StaticResource DetailTab}" IsChecked="True"
                             ToolTip="The model and the effort of each role." Checked="DetailTab_Checked" />
                <RadioButton x:Name="PreviewTab" GroupName="SetupDetails" Content="Preview" Style="{StaticResource DetailTab}"
                             ToolTip="The sessions that would start, with editable full briefs." Checked="DetailTab_Checked" />
            </StackPanel>
        </Border>

        <Grid Grid.Row="2" Margin="20,10,8,8">
            <!-- Models: one line per role, and the helper of each role beside it. The lines wrap in a narrow pane. -->
            <ScrollViewer x:Name="ModelsPanel" VerticalScrollBarVisibility="Auto">
                <StackPanel MaxWidth="900" HorizontalAlignment="Left">
                    <WrapPanel Margin="0,0,0,2">
                        <StackPanel Orientation="Horizontal" Margin="0,0,28,6">
                            <TextBlock Text="Planner" Style="{StaticResource RoleLabel}"
                                       ToolTip="The planner plans the work, sends each batch to a coder, and reviews each report." />
                            <ComboBox x:Name="PlannerModelBox" Width="110" ToolTip="The model that plans and reviews. Opus is the default." SelectionChanged="OnSelectionChanged" />
                            <ComboBox x:Name="PlannerEffortBox" Width="110" Margin="8,0,0,0" ToolTip="How hard the planner thinks. High is the default."
                                      SelectionChanged="OnSelectionChanged" />
                        </StackPanel>
                        <StackPanel x:Name="ReviewerRow" Orientation="Horizontal" Margin="0,0,0,6">
                            <TextBlock Text="↪ Reviewer" Style="{StaticResource RoleLabel}"
                                       ToolTip="Who reviews each coder report: the planner itself, or a subagent on the chosen model." />
                            <ComboBox x:Name="ReviewerBox" Width="110"
                                      ToolTip="self: the planner reviews, and its context grows with each review. A model: a subagent reviews, so the planner's context stays small."
                                      SelectionChanged="OnSelectionChanged">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Label}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <TextBlock x:Name="ReviewerFootnote" Style="{StaticResource Info}"
                                       ToolTip="* self costs the most: the planner's context grows with every review. Sonnet, the default, reviews in a subagent. For a one-batch task, self is enough." />
                        </StackPanel>
                    </WrapPanel>

                    <WrapPanel Margin="0,0,0,2">
                        <StackPanel x:Name="CoderRow" Orientation="Horizontal" Margin="0,0,28,6">
                            <TextBlock Text="Coder" Style="{StaticResource RoleLabel}"
                                       ToolTip="The coder does each batch, with its tests, and reports back to the planner." />
                            <ComboBox x:Name="CoderModelBox" Width="110" ToolTip="The model that does the work. Haiku is the cheapest." SelectionChanged="OnSelectionChanged" />
                            <ComboBox x:Name="CoderEffortBox" Width="110" Margin="8,0,0,0" ToolTip="How hard the coder thinks. Medium is the default."
                                      SelectionChanged="OnSelectionChanged" />
                        </StackPanel>
                        <!-- The optional assistant (D-S41): none by default. It answers the coders' quick questions, and costs only when asked. -->
                        <StackPanel x:Name="AssistantRow" Orientation="Horizontal" Margin="0,0,0,6">
                            <TextBlock Text="↪ Assistant" Style="{StaticResource RoleLabel}"
                                       ToolTip="An optional helper for the coders. It answers their short questions in a few lines, and costs only when asked. None is the default." />
                            <ComboBox x:Name="AssistantBox" Width="110"
                                      ToolTip="Who answers the coders' quick questions. None is the default: nothing extra runs or costs."
                                      SelectionChanged="OnSelectionChanged" />
                            <ComboBox x:Name="AssistantEffortBox" Width="110" Margin="8,0,0,0"
                                      ToolTip="How hard the assistant thinks when it answers. Medium is the default."
                                      SelectionChanged="OnSelectionChanged" />
                        </StackPanel>
                    </WrapPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                        <TextBlock Foreground="{DynamicResource SetupMuted}" FontSize="12"
                                   Text="Permission mode: auto, the same for every session in a run." />
                        <TextBlock Style="{StaticResource Info}"
                                   ToolTip="Fable is the most expensive model. Not every model is verified with every effort level yet." />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <!-- Preview: session models and editable full briefs. -->
            <ScrollViewer x:Name="PreviewPanel" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                <StackPanel Margin="0,0,12,0" MaxWidth="900" HorizontalAlignment="Left">
                    <TextBlock x:Name="PreviewEmpty" Foreground="{DynamicResource SetupMuted}" TextWrapping="Wrap"
                               Text="Nothing to preview yet. The line beside Start says what is missing." />
                    <StackPanel x:Name="PreviewContent" Visibility="Collapsed">
                        <TextBlock x:Name="PreviewSessionsText" FontFamily="Consolas" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,8" />
                        <TextBlock Foreground="{DynamicResource SetupMuted}" FontSize="12" TextWrapping="Wrap" Text="Saved per pattern. Tags: {task}, {plannername}, {codername}, {codernames}, {reviewername}, {assistantname}, {reviewclause}, {assistantclause}. They expand when a run starts." Margin="0,0,0,8" />
                        <TextBlock Text="Planner brief" FontWeight="SemiBold" Margin="0,0,0,4" />
                        <TextBox x:Name="PlannerBriefBox" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="120" MinWidth="520" Margin="0,0,0,12"
                                 ToolTip="The planner's saved brief. Its tags expand to the current run values when a run starts."
                                 TextChanged="PlannerBrief_TextChanged" />
                        <StackPanel x:Name="CoderBriefEditor">
                            <TextBlock Text="Coder brief (shared by all coders)" FontWeight="SemiBold" Margin="0,0,0,4" />
                            <TextBox x:Name="CoderBriefBox" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="120" MinWidth="520" Margin="0,0,0,8"
                                     ToolTip="The saved brief sent to every coder. Its tags are shown above."
                                     TextChanged="CoderBrief_TextChanged" />
                        </StackPanel>
                        <WrapPanel Margin="0,4,0,8">
                            <Button x:Name="SaveBriefsButton" Content="Save briefs" Click="SaveBriefs_Click" IsEnabled="False" Margin="0,0,8,0"
                                    ToolTip="Save these briefs for this pattern." />
                            <Button x:Name="ResetBriefsButton" Content="Reset to the templates" Click="ResetBriefs_Click" IsEnabled="False"
                                    ToolTip="Discard the saved briefs and take the built-in templates again." />
                        </WrapPanel>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- The footer: always on screen. Its columns are in reading order: Start, the one-line summary, the start time, the limits. -->
        <Border Grid.Row="3" BorderBrush="{DynamicResource SetupBorder}" BorderThickness="0,1,0,0"
                Background="{DynamicResource SetupPanel}" Padding="20,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button x:Name="StartButton" Grid.Column="0" Padding="22,7" FontWeight="SemiBold"
                        Style="{StaticResource GoButton}" VerticalAlignment="Center"
                        ToolTip="Checks the run and saves the settings for the next launch. The sessions start on the next pass, within about 15 seconds. A running session keeps its brief."
                        Click="Start_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE768;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="13" Margin="0,1,8,0" VerticalAlignment="Center" />
                        <TextBlock Text="Start" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="14,0,0,0">
                    <TextBlock x:Name="SummaryText" Foreground="{DynamicResource SetupMuted}" TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="StartStatus" TextWrapping="Wrap" Visibility="Collapsed" Margin="0,2,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="14,0,0,0">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <TextBlock Text="Start at" VerticalAlignment="Center" Foreground="{DynamicResource SetupMuted}" Margin="0,0,6,0" />
                        <TextBox x:Name="StartAtBox" Width="64" MaxLength="5"
                                 ToolTip="Optional. A 24-hour time, HH:mm, on this computer's clock. The run waits until then. Blank starts it at once." />
                    </StackPanel>
                    <CheckBox x:Name="WaitForLimitBox" Content="Start when the usage limit resets" FontSize="11" HorizontalAlignment="Right"
                              Margin="0,2,0,0" Foreground="{DynamicResource SetupMuted}"
                              ToolTip="The run waits until the reset time of the last usage limit Claude Code reported on this computer (plus 2 minutes). If no limit is active, it starts at once."
                              Checked="WaitForLimit_Changed" Unchecked="WaitForLimit_Changed" />
                    <TextBlock Text="Starts only while this window is open." FontSize="11" HorizontalAlignment="Right"
                               Foreground="{DynamicResource SetupMuted}" />
                </StackPanel>
                <StackPanel Grid.Column="3" VerticalAlignment="Center" Margin="14,0,0,0">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <TextBlock Text="Limit: tokens" VerticalAlignment="Center" Foreground="{DynamicResource SetupMuted}" Margin="0,0,6,0" />
                        <TextBox x:Name="LimitTokensBox" Width="84" ToolTip="Optional. The most output tokens this run may write. Blank is no limit." />
                        <TextBlock Text="minutes" VerticalAlignment="Center" Foreground="{DynamicResource SetupMuted}" Margin="8,0,6,0" />
                        <TextBox x:Name="LimitMinutesBox" Width="64" ToolTip="Optional. The most minutes this run may run. Blank is no limit." />
                    </StackPanel>
                    <TextBlock Text="At 80 % you are told; at the limit nothing new starts." FontSize="11" HorizontalAlignment="Right"
                               Foreground="{DynamicResource SetupMuted}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
