<Window x:Class="OpenTail.Bullshark.App.SessionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OpenTail.Bullshark" Width="1100" Height="700"
        Background="#1E1E1E" Foreground="#E6E6E6">
    <!-- One thin scrollbar for the whole window: no arrows, and a rounded thumb in the rail palette's muted colour. ApplyTheme
         sets ScrollThumb and ScrollThumbHover. The default Windows 11 bar is light and has arrows, which looked unfinished. -->
    <Window.Resources>
        <SolidColorBrush x:Key="BarText" Color="#CCCCCC" />
        <SolidColorBrush x:Key="BarMuted" Color="#CCCCCC" />
        <SolidColorBrush x:Key="BarHover" Color="#33FFFFFF" />
        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Track x:Name="PART_Track" IsDirectionReversed="True" Orientation="{TemplateBinding Orientation}">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False" />
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False" />
                            </Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb>
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border x:Name="Bar" Background="{DynamicResource ScrollThumb}" CornerRadius="4" Margin="2" />
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bar" Property="Background" Value="{DynamicResource ScrollThumbHover}" />
                                                </Trigger>
                                                <Trigger Property="IsDragging" Value="True">
                                                    <Setter TargetName="Bar" Property="Background" Value="{DynamicResource ScrollThumbHover}" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Orientation" Value="Horizontal">
                                <Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Vertical">
                    <Setter Property="Width" Value="10" />
                </Trigger>
                <Trigger Property="Orientation" Value="Horizontal">
                    <Setter Property="Height" Value="10" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <DockPanel>
        <Border x:Name="StatusBar" DockPanel.Dock="Bottom" Padding="10,4">
            <!-- Two rows (2026-11-18): the controls on top and the status text under them, on the full width. With the text in the same
                 row it got whatever width the buttons left, which was nearly none on a 1366 px window, so it wrapped one letter to a line
                 and the bar grew over the whole window. -->
            <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <DockPanel Grid.Row="0" LastChildFill="False">
                <!-- The number of sessions that wait for the owner (the Needs you group of the rail). Collapsed while there are none. -->
                <TextBlock x:Name="NeedsYouText" DockPanel.Dock="Left" Visibility="Collapsed" FontSize="12" FontWeight="SemiBold"
                           VerticalAlignment="Center" Margin="0,0,14,0" Foreground="{DynamicResource BarText}"
                           ToolTip="Sessions that wait for you. They are listed under Needs you at the top of the rail." />
                <!-- The zoom of the terminals and the transcripts, as in Word's status bar (zoom.md). -->
                <StackPanel x:Name="ZoomBar" DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0"
                            ToolTip="Zoom the session text: the transcripts and the terminals. Ctrl+plus, Ctrl+minus and Ctrl+0 do the same.">
                    <TextBlock x:Name="ZoomOut" Text="−" FontSize="15" Foreground="{DynamicResource BarText}" Cursor="Hand" Padding="6,0"
                               VerticalAlignment="Center" ToolTip="Zoom out" MouseLeftButtonUp="ZoomOut_Click" />
                    <Slider x:Name="ZoomSlider" Width="110" Minimum="0" Maximum="10" TickFrequency="1" IsSnapToTickEnabled="True"
                            VerticalAlignment="Center" ToolTip="Zoom" ValueChanged="ZoomSlider_ValueChanged" />
                    <TextBlock x:Name="ZoomIn" Text="+" FontSize="15" Foreground="{DynamicResource BarText}" Cursor="Hand" Padding="6,0"
                               VerticalAlignment="Center" ToolTip="Zoom in" MouseLeftButtonUp="ZoomIn_Click" />
                    <TextBlock x:Name="ZoomPercentText" Text="100%" Width="52" TextAlignment="Right" FontFamily="Consolas" FontSize="12"
                               Foreground="{DynamicResource BarText}" Cursor="Hand" VerticalAlignment="Center" Margin="4,0,0,0"
                               ToolTip="Back to 100%" MouseLeftButtonUp="ZoomPercent_Click" />
                </StackPanel>
                <!-- Flat status-bar labels, as in GitHub Copilot: no bevel; a light highlight when the pointer is over them. -->
                <Border x:Name="InstructionsLabel" DockPanel.Dock="Right" Margin="10,0,0,0" Padding="5,1" CornerRadius="3"
                        VerticalAlignment="Center" Cursor="Hand" AutomationProperties.Name="Instructions"
                        MouseLeftButtonUp="InstructionsLabel_Click" ToolTip="Edit Claude's standing instructions: yours, and the ones in the projects Claude has been trusted in.">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="Transparent" />
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource BarHover}" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock Text="⚙️" FontSize="14" Foreground="{DynamicResource BarText}" />
                </Border>
                <Border x:Name="SetupCheckLabel" DockPanel.Dock="Right" Margin="10,0,0,0" Padding="5,1" CornerRadius="3"
                        VerticalAlignment="Center" Cursor="Hand" AutomationProperties.Name="Setup check"
                        MouseLeftButtonUp="SetupCheckLabel_Click" ToolTip="Checks Claude Code's settings, hooks, MCP servers and CLAUDE.md on this computer. Reads only.">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="Transparent" />
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource BarHover}" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock Text="🔧" FontSize="14" Foreground="{DynamicResource BarText}" />
                </Border>
                <Button x:Name="TrustButton" Style="{StaticResource GhostButton}" DockPanel.Dock="Right" Visibility="Collapsed" Margin="6,0,0,0" Click="TrustButton_Click" >
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE72E;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="13" Margin="0,1,7,0" VerticalAlignment="Center" />
                        <TextBlock Text="Restart trust step" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button x:Name="RetryButton" Style="{StaticResource GhostButton}" DockPanel.Dock="Right" Visibility="Collapsed" Margin="6,0,0,0" Click="RetryButton_Click"
                        ToolTip="Tries the sessions whose start failed. Nothing is retried on its own." >
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE72C;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="13" Margin="0,1,7,0" VerticalAlignment="Center" />
                        <TextBlock Text="Retry failed starts" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button x:Name="RespawnButton" Style="{StaticResource GhostButton}" DockPanel.Dock="Right" Visibility="Collapsed" Margin="6,0,0,0" Click="RespawnButton_Click"
                        ToolTip="The background daemon runs another claude version. Respawn all restarts the background sessions after you confirm." >
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE777;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="13" Margin="0,1,7,0" VerticalAlignment="Center" />
                        <TextBlock Text="Respawn all…" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button x:Name="GoToButton" Style="{StaticResource GhostButton}" DockPanel.Dock="Right" Margin="6,0,0,0"
                        Click="GoToButton_Click"
                        ToolTip="Jump to a session or a page, or run a safe action. Ctrl+Shift+P does the same." >
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE721;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="13" Margin="0,1,7,0" VerticalAlignment="Center" />
                        <TextBlock Text="Go to…" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button x:Name="TimelineButton" Style="{StaticResource GhostButton}" DockPanel.Dock="Right" Margin="6,0,0,0"
                        Click="TimelineButton_Click" ToolTip="What the supervisor did, run by run: starts, resumes, alerts and state changes." >
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE81C;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="13" Margin="0,1,7,0" VerticalAlignment="Center" />
                        <TextBlock Text="Timeline" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button x:Name="StorageButton" Style="{StaticResource GhostButton}" DockPanel.Dock="Right" Margin="6,0,0,0"
                        Click="StorageButton_Click" ToolTip="How much the transcripts take up, and the archive of old ones." >
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xEDA2;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="13" Margin="0,1,7,0" VerticalAlignment="Center" />
                        <TextBlock Text="Storage" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button x:Name="LimitsButton" Style="{StaticResource GhostButton}" DockPanel.Dock="Right" Margin="6,0,0,0"
                        Click="LimitsButton_Click" ToolTip="The usage limits Claude Code reached on this computer in the last 30 days, by day, with the tokens used before each." >
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE9D9;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="13" Margin="0,1,7,0" VerticalAlignment="Center" />
                        <TextBlock Text="Limits" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button x:Name="AwayButton" Style="{StaticResource GhostButton}" DockPanel.Dock="Right" Margin="6,0,0,0"
                        Click="AwayButton_Click" ToolTip="What happened while you were away: each session's activity, the supervisor's events and the limits hit. Reads only; nothing is sent to a session." >
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE708;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="13" Margin="0,1,7,0" VerticalAlignment="Center" />
                        <TextBlock Text="Away" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </DockPanel>
            <!-- Second row: the usage limit in force (A2), then the status text. They sit here, not in the row of controls, so that the
                 controls keep their width on a narrow window. -->
            <DockPanel Grid.Row="1" Margin="0,2,0,0">
                <TextBlock x:Name="LimitStatusText" DockPanel.Dock="Left" Visibility="Collapsed" FontSize="12" FontWeight="SemiBold"
                           VerticalAlignment="Center" Margin="0,0,14,0" Foreground="{DynamicResource BarText}" MaxWidth="520"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock x:Name="StatusText" Foreground="{DynamicResource BarMuted}" FontFamily="Consolas" FontSize="12" Text="starting…"
                           TextWrapping="Wrap" MaxHeight="64" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
            </DockPanel>
            </Grid>
        </Border>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="RailColumn" Width="0.3*" MinWidth="180" />
                <ColumnDefinition x:Name="SplitterColumn" Width="5" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- The rail: live sessions grouped by folder, and one History section at the bottom. Colours come from RailTheme. -->
            <DockPanel x:Name="RailPanel" Grid.Column="0" Background="#111316">
                <DockPanel DockPanel.Dock="Top" Margin="8,8,8,4">
                    <TextBlock x:Name="ThemeMark" DockPanel.Dock="Right" Cursor="Hand" FontSize="12" VerticalAlignment="Center"
                               ToolTip="Switch between the dark and the light rail" MouseLeftButtonUp="ThemeMark_Click" />
                    <Border x:Name="FilterBox" DockPanel.Dock="Right" Cursor="Hand" CornerRadius="4" BorderThickness="1"
                            Padding="8,2" Margin="0,0,12,0" VerticalAlignment="Center"
                            ToolTip="Choose what the rail shows" MouseLeftButtonUp="FilterMark_Click">
                        <TextBlock x:Name="FilterMark" FontSize="12" />
                    </Border>
                    <TextBlock x:Name="SessionsTitle" Text="Sessions" FontWeight="SemiBold" VerticalAlignment="Center" />
                </DockPanel>
                <!-- Search what was said in past sessions (docs/plans/history-search.md). Three letters or more per word. -->
                <Grid DockPanel.Dock="Bottom" Margin="8,4,8,8">
                    <TextBox x:Name="SearchBox" Padding="6,3,26,3" VerticalContentAlignment="Center" FontSize="12" BorderThickness="1"
                             ToolTip="Search what was said in your past sessions. Each word needs three letters or more. Enter searches at once."
                             KeyDown="SearchBox_KeyDown" TextChanged="SearchBox_TextChanged" />
                    <TextBlock x:Name="SearchHint" Text="Search what was said (3+ letters per word)" IsHitTestVisible="False"
                               FontSize="12" Margin="8,0,0,0" VerticalAlignment="Center" />
                    <TextBlock x:Name="SearchBusy" Text="⏳" FontSize="12" HorizontalAlignment="Right" Margin="0,0,8,0"
                               VerticalAlignment="Center" IsHitTestVisible="False" Visibility="Collapsed" ToolTip="Searching…" />
                </Grid>
                <TreeView x:Name="Rail" Background="#111316" Foreground="#E6E6E6" BorderThickness="0"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                          SelectedItemChanged="Rail_SelectedItemChanged" />
            </DockPanel>

            <GridSplitter x:Name="RailSplitter" Grid.Column="1" Width="6" HorizontalAlignment="Stretch" Background="#333333"
                          ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" ShowsPreview="False"
                          DragStarted="Splitter_DragStarted" DragCompleted="Splitter_DragCompleted" />

            <!-- The right column: the tab strip sits directly above the terminals it stands for (D-S39), and the pane holds them.
                 The tabs belong to the pane, not to the window, so the rail runs the full height beside them. -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <!-- The second and third columns are the split (docs/plans/tabs-and-panes.md, T2). They have no width until a
                     session tab is moved to the right pane. -->
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="PaneColumn" Width="*" />
                    <ColumnDefinition x:Name="PaneSplitterColumn" Width="0" />
                    <ColumnDefinition x:Name="PaneBColumn" Width="0" />
                </Grid.ColumnDefinitions>

                <!-- One tab per live session, the setup tab, and "+" for a new session. -->
                <Border Grid.Row="0" x:Name="TabBar" Background="#1A1B1E" Padding="6,4,6,0">
                    <DockPanel>
                        <!-- Hides the whole sessions rail, or shows it again. The tab bar is always there, so the toggle always is too. -->
                        <TextBlock x:Name="RailToggle" DockPanel.Dock="Left" Cursor="Hand" FontSize="11"
                                   Margin="0,0,4,0" Padding="8,4,6,4" Background="Transparent" VerticalAlignment="Center"
                                   MouseLeftButtonUp="RailToggle_Click" />
                        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                            <StackPanel x:Name="TabStrip" Orientation="Horizontal" />
                        </ScrollViewer>
                    </DockPanel>
                </Border>

                <!-- Every terminal lives here in one cell. Only the chosen one is Visible; the others are Hidden,
                     never Collapsed, so each keeps its size and its process (F45). A session's terminal moves to the right pane and back (F55). -->
                <Grid x:Name="Pane" Grid.Row="1" Background="#1E1E1E" />

                <!-- The right pane, shown only while the pane is split. It holds session terminals only, with its own strip. -->
                <GridSplitter x:Name="PaneSplitter" Grid.Row="0" Grid.RowSpan="2" Grid.Column="1" Width="5" Visibility="Collapsed"
                              HorizontalAlignment="Stretch" Background="#333333"
                              ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" ShowsPreview="False" />
                <Border Grid.Row="0" Grid.Column="2" x:Name="TabBarB" Background="#1A1B1E" Padding="6,4,6,0" Visibility="Collapsed">
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                        <StackPanel x:Name="TabStripB" Orientation="Horizontal" />
                    </ScrollViewer>
                </Border>
                <Grid x:Name="PaneB" Grid.Row="1" Grid.Column="2" Background="#1E1E1E" Visibility="Collapsed" />
            </Grid>
        </Grid>
    </DockPanel>
</Window>
