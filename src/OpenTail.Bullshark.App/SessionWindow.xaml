<Window x:Class="OpenTail.Bullshark.App.SessionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OpenTail.Bullshark" Width="1100" Height="700"
        Background="#1E1E1E" Foreground="#E6E6E6">
    <!-- One thin scrollbar for the whole window: no arrows, and a rounded thumb in the rail palette's muted colour. ApplyTheme
         sets ScrollThumb and ScrollThumbHover. The default Windows 11 bar is light and has arrows, which looked unfinished. -->
    <Window.Resources>
        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Track x:Name="PART_Track" IsDirectionReversed="True" Orientation="{TemplateBinding Orientation}">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False" />
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False" />
                            </Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb>
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border x:Name="Bar" Background="{DynamicResource ScrollThumb}" CornerRadius="4" Margin="2" />
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bar" Property="Background" Value="{DynamicResource ScrollThumbHover}" />
                                                </Trigger>
                                                <Trigger Property="IsDragging" Value="True">
                                                    <Setter TargetName="Bar" Property="Background" Value="{DynamicResource ScrollThumbHover}" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Orientation" Value="Horizontal">
                                <Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Vertical">
                    <Setter Property="Width" Value="10" />
                </Trigger>
                <Trigger Property="Orientation" Value="Horizontal">
                    <Setter Property="Height" Value="10" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <DockPanel>
        <Border DockPanel.Dock="Bottom" Background="#252526" Padding="10,4">
            <DockPanel>
                <Button x:Name="TrustButton" DockPanel.Dock="Right" Visibility="Collapsed" Padding="10,2" Margin="10,0,0,0"
                        Content="Restart trust step" Click="TrustButton_Click" />
                <Button x:Name="RetryButton" DockPanel.Dock="Right" Visibility="Collapsed" Padding="10,2" Margin="10,0,0,0"
                        Content="Retry failed starts" Click="RetryButton_Click"
                        ToolTip="Tries the sessions whose start failed. Nothing is retried on its own." />
                <TextBlock x:Name="StatusText" Foreground="#CCCCCC" FontFamily="Consolas" FontSize="12" Text="starting…"
                           TextWrapping="Wrap" VerticalAlignment="Center" />
            </DockPanel>
        </Border>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="0.3*" MinWidth="180" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- The rail: live sessions grouped by folder, and one History section at the bottom. Colours come from RailTheme. -->
            <DockPanel x:Name="RailPanel" Grid.Column="0" Background="#111316">
                <DockPanel DockPanel.Dock="Top" Margin="8,8,8,4">
                    <TextBlock x:Name="ThemeMark" DockPanel.Dock="Right" Cursor="Hand" FontSize="12" VerticalAlignment="Center"
                               ToolTip="Switch between the dark and the light rail" MouseLeftButtonUp="ThemeMark_Click" />
                    <Border x:Name="FilterBox" DockPanel.Dock="Right" Cursor="Hand" CornerRadius="4" BorderThickness="1"
                            Padding="8,2" Margin="0,0,12,0" VerticalAlignment="Center"
                            ToolTip="Choose what the rail shows" MouseLeftButtonUp="FilterMark_Click">
                        <TextBlock x:Name="FilterMark" FontSize="12" />
                    </Border>
                    <TextBlock x:Name="SessionsTitle" Text="Sessions" FontWeight="SemiBold" VerticalAlignment="Center" />
                </DockPanel>
                <TreeView x:Name="Rail" Background="#111316" Foreground="#E6E6E6" BorderThickness="0"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                          SelectedItemChanged="Rail_SelectedItemChanged" />
            </DockPanel>

            <GridSplitter x:Name="RailSplitter" Grid.Column="1" Width="6" HorizontalAlignment="Stretch" Background="#333333"
                          ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" ShowsPreview="False"
                          DragStarted="Splitter_DragStarted" DragCompleted="Splitter_DragCompleted" />

            <!-- The right column: the tab strip sits directly above the terminals it stands for (D-S39), and the pane holds them.
                 The tabs belong to the pane, not to the window, so the rail runs the full height beside them. -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- One tab per live session, the setup tab, and "+" for a new session. -->
                <Border Grid.Row="0" x:Name="TabBar" Background="#1A1B1E" Padding="6,4,6,0">
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                        <StackPanel x:Name="TabStrip" Orientation="Horizontal" />
                    </ScrollViewer>
                </Border>

                <!-- Every terminal lives here in one cell. Only the chosen one is Visible; the others are Hidden,
                     never Collapsed, so each keeps its size and its process (F45). Nothing is moved between parents. -->
                <Grid x:Name="Pane" Grid.Row="1" Background="#1E1E1E" />
            </Grid>
        </Grid>
    </DockPanel>
</Window>
