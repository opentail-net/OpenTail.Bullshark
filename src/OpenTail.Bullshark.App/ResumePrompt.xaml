<Window x:Class="OpenTail.Bullshark.App.ResumePrompt"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Resume a session"
        SizeToContent="WidthAndHeight" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource PromptBg}" Foreground="{DynamicResource PromptText}" FontFamily="Segoe UI">
    <Window.Resources>
        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Padding" Value="14,7" />
            <Setter Property="Margin" Value="0,0,8,0" />
        </Style>
        <!-- Resume is the app's green launch button (P6, 2026-11-19). This style keeps only the size: it is based on the app's GoButton, and the
             window's own Button style below is not in its chain, so the colours are the green, not the grey of the Button style. -->
        <Style x:Key="ResumeGo" TargetType="Button" BasedOn="{StaticResource GoButton}">
            <Setter Property="Padding" Value="20,7" />
            <Setter Property="Margin" Value="0,0,8,0" />
        </Style>

        <Style TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource PromptText}" />
            <Setter Property="Margin" Value="0,0,0,6" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <StackPanel Orientation="Horizontal">
                            <Grid Width="14" Height="14" Margin="0,0,8,0" VerticalAlignment="Center">
                                <Ellipse Stroke="{DynamicResource PromptMuted}" StrokeThickness="1.4" />
                                <Ellipse x:Name="Dot" Width="6" Height="6" Fill="{DynamicResource PromptText}" Visibility="Collapsed" />
                            </Grid>
                            <ContentPresenter VerticalAlignment="Center" />
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Dot" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- A segment of a row of choices (the model and the effort): the chosen one shows pressed. -->
        <Style x:Key="Segment" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource PromptText}" />
            <Setter Property="Margin" Value="0,0,6,6" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Frame" Background="{DynamicResource PromptPanel}"
                                BorderBrush="{DynamicResource PromptBorder}" BorderThickness="1" CornerRadius="3" Padding="10,4">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource PromptMuted}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Frame" Property="Background" Value="{DynamicResource PromptSelection}" />
                                <Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource PromptText}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Section" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,14,0,6" />
        </Style>

        <Style x:Key="Muted" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource PromptMuted}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </Window.Resources>

    <StackPanel Margin="20" Width="580">
        <TextBlock x:Name="Heading" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" />
        <TextBlock x:Name="Facts" Style="{StaticResource Muted}" Margin="0,6,0,0" />

        <TextBlock x:Name="Recommendation" Style="{StaticResource Muted}" Margin="0,10,0,0" />

        <TextBlock Style="{StaticResource Section}" Text="How to continue" />
        <RadioButton x:Name="FullChoice" GroupName="Resume" Content="In full" />
        <RadioButton x:Name="SummaryChoice" GroupName="Resume" Content="From a summary, then a new session" />

        <StackPanel x:Name="LevelBlock" Margin="22,0,0,4">
            <WrapPanel x:Name="LevelRow" Orientation="Horizontal" />
            <TextBlock Style="{StaticResource Muted}" Margin="0,0,0,4"
                       Text="Haiku writes it from your messages and Claude's replies. The tool output is left out." />
        </StackPanel>

        <RadioButton x:Name="TailChoice" GroupName="Resume" Content="The last turns only (no model call)" />

        <StackPanel x:Name="TurnsBlock">
            <StackPanel Orientation="Horizontal" Margin="22,6,0,0">
                <TextBlock Text="Keep the last" VerticalAlignment="Center" Margin="0,0,8,0" />
                <TextBox x:Name="TurnsBox" Width="56" Padding="6,3" VerticalContentAlignment="Center" />
                <TextBlock Text="turns" VerticalAlignment="Center" Margin="8,0,0,0" />
            </StackPanel>
            <TextBlock Style="{StaticResource Muted}" Margin="22,2,0,0"
                       Text="Word for word, with tool results on one line each, and at most about 4,000 tokens. The oldest turn goes first." />
        </StackPanel>

        <TextBlock Style="{StaticResource Section}" Text="Model and effort for the session that continues" />
        <StackPanel Orientation="Horizontal">
            <TextBlock Text="Model" Width="60" VerticalAlignment="Center" Style="{StaticResource Muted}" />
            <WrapPanel x:Name="ModelRow" Orientation="Horizontal" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
            <TextBlock Text="Effort" Width="60" VerticalAlignment="Center" Style="{StaticResource Muted}" />
            <WrapPanel x:Name="EffortRow" Orientation="Horizontal" />
        </StackPanel>

        <TextBlock x:Name="CostText" Style="{StaticResource Muted}" Margin="0,16,0,0" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="Resume" Click="Resume_Click" Style="{StaticResource ResumeGo}" />
            <Button Content="Cancel" IsCancel="True" IsDefault="True" Click="Cancel_Click" Margin="0" />
        </StackPanel>
    </StackPanel>
</Window>
