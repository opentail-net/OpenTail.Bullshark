<Window x:Class="OpenTail.Bullshark.App.ResumePrompt"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        SizeToContent="WidthAndHeight" ResizeMode="CanResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource PromptBg}" Foreground="{DynamicResource PromptText}" FontFamily="Segoe UI">
    <Window.Resources>
        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Padding" Value="14,7" />
            <Setter Property="Margin" Value="0,0,8,0" />
        </Style>
        <!-- Resume is the app's green launch button (P6, 2026-11-19), cut in two (2026-11-20): the main part resumes, and the narrow part on its right
             opens the menu with the preview. Both are based on the app's GoButton, so the colours and the hover are the app's; the templates only
             round the outer corners (8 is the app's UiRadius) and leave the join square. The window's own Button style below is not in these chains. -->
        <Style x:Key="ResumeGo" TargetType="Button" BasedOn="{StaticResource GoButton}">
            <Setter Property="Padding" Value="20,7" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="Ring" CornerRadius="10,0,0,10" BorderThickness="2" BorderBrush="Transparent" Margin="-2" />
                            <Border x:Name="Frame" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="8,0,0,8" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                                  TextElement.Foreground="{TemplateBinding Foreground}" />
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Frame" Property="Background" Value="{DynamicResource UiGoHover}" />
                                <Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource UiGoHover}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Frame" Property="Background" Value="{DynamicResource UiGoPressed}" />
                                <Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource UiGoPressed}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Ring" Property="BorderBrush" Value="{DynamicResource UiAccent}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- The narrow part of the split button: the same green, with the corners on its right rounded. -->
        <Style x:Key="ResumeMenuPart" TargetType="Button" BasedOn="{StaticResource GoButton}">
            <Setter Property="Padding" Value="9,7" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="Ring" CornerRadius="0,10,10,0" BorderThickness="2" BorderBrush="Transparent" Margin="-2" />
                            <Border x:Name="Frame" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="0,8,8,0" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                                  TextElement.Foreground="{TemplateBinding Foreground}" />
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Frame" Property="Background" Value="{DynamicResource UiGoHover}" />
                                <Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource UiGoHover}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Frame" Property="Background" Value="{DynamicResource UiGoPressed}" />
                                <Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource UiGoPressed}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Ring" Property="BorderBrush" Value="{DynamicResource UiAccent}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource PromptText}" />
            <Setter Property="Margin" Value="0,0,0,6" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <StackPanel Orientation="Horizontal">
                            <Grid Width="14" Height="14" Margin="0,0,8,0" VerticalAlignment="Center">
                                <Ellipse Stroke="{DynamicResource PromptMuted}" StrokeThickness="1.4" />
                                <Ellipse x:Name="Dot" Width="6" Height="6" Fill="{DynamicResource PromptText}" Visibility="Collapsed" />
                            </Grid>
                            <ContentPresenter VerticalAlignment="Center" />
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Dot" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- A segment of a row of choices (the model and the effort): the chosen one shows pressed. -->
        <Style x:Key="Segment" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource PromptText}" />
            <Setter Property="Margin" Value="0,0,6,6" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Frame" Background="{DynamicResource PromptPanel}"
                                BorderBrush="{DynamicResource PromptBorder}" BorderThickness="1" CornerRadius="3" Padding="10,4">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource PromptMuted}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Frame" Property="Background" Value="{DynamicResource PromptSelection}" />
                                <Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource PromptText}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Section" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,14,0,6" />
        </Style>

        <Style x:Key="Muted" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource PromptMuted}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="20,20,20,0" Width="580">
                <TextBlock x:Name="Heading" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" />
                <TextBlock x:Name="Facts" Style="{StaticResource Muted}" Margin="0,6,0,0" />
                <TextBlock x:Name="FolderNotice" Foreground="{DynamicResource UiDanger}" TextWrapping="Wrap" Margin="0,8,0,0" Visibility="Collapsed" />

                <TextBlock x:Name="Recommendation" Style="{StaticResource Muted}" Margin="0,10,0,0" />

                <TextBlock Style="{StaticResource Section}" Text="How to continue" />
                <RadioButton x:Name="FullChoice" GroupName="Resume" Content="In full" />
                <RadioButton x:Name="SummaryChoice" GroupName="Resume" Content="From a summary, then a new session" />

                <StackPanel x:Name="LevelBlock" Margin="22,0,0,4">
                    <!-- The platform the new session starts in (RS-D3, RS-D4) is picked in the Resume menu, a summary only. The line names both platforms when they differ. -->
                    <TextBlock x:Name="TargetLine" Style="{StaticResource Muted}" Margin="0,0,0,6" />
                    <WrapPanel x:Name="LevelRow" Orientation="Horizontal" />
                    <TextBlock Style="{StaticResource Muted}" Margin="0,0,0,4"
                               Text="Haiku writes it from your messages and Claude's replies. The tool output is left out." />
                </StackPanel>

                <RadioButton x:Name="TailChoice" GroupName="Resume" Content="The last turns only (no model call)" />

                <StackPanel x:Name="TurnsBlock">
                    <StackPanel Orientation="Horizontal" Margin="22,6,0,0">
                        <TextBlock Text="Keep the last" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBox x:Name="TurnsBox" Width="56" Padding="6,3" VerticalContentAlignment="Center" />
                        <TextBlock Text="turns" VerticalAlignment="Center" Margin="8,0,0,0" />
                    </StackPanel>
                    <TextBlock Style="{StaticResource Muted}" Margin="22,2,0,0"
                               Text="Word for word, with tool results on one line each, and at most about 4,000 tokens. The oldest turn goes first." />
                </StackPanel>

                <TextBlock x:Name="ModelHeader" Style="{StaticResource Section}" Text="Model and effort for the session that continues" />
                <StackPanel x:Name="ModelLine" Orientation="Horizontal">
                    <TextBlock Text="Model" Width="60" VerticalAlignment="Center" Style="{StaticResource Muted}" />
                    <WrapPanel x:Name="ModelRow" Orientation="Horizontal" />
                </StackPanel>
                <StackPanel x:Name="EffortLine" Orientation="Horizontal" Margin="0,2,0,0">
                    <TextBlock Text="Effort" Width="60" VerticalAlignment="Center" Style="{StaticResource Muted}" />
                    <WrapPanel x:Name="EffortRow" Orientation="Horizontal" />
                </StackPanel>

                <TextBlock x:Name="CostText" Style="{StaticResource Muted}" Margin="0,16,0,0" />

                <!-- The prompt the new session would get, shown before anything runs. Hidden until a preview is made, and hidden again when the choice changes. -->
                <StackPanel x:Name="PreviewBlock" Visibility="Collapsed" Margin="0,14,0,0">
                    <TextBlock x:Name="PreviewHeader" Style="{StaticResource Muted}" />
                    <TextBox x:Name="PreviewText" IsReadOnly="True" TextWrapping="Wrap" FontFamily="Consolas" FontSize="12"
                             MaxHeight="220" VerticalScrollBarVisibility="Auto" Margin="0,6,0,0" Padding="8"
                             Background="{DynamicResource PromptPanel}" Foreground="{DynamicResource PromptText}"
                             BorderBrush="{DynamicResource PromptBorder}" />
                    <TextBlock x:Name="PreviewNote" Style="{StaticResource Muted}" Margin="0,4,0,0" Visibility="Collapsed" />
                </StackPanel>

                <CheckBox x:Name="RememberBox" Content="Remember for this session" Foreground="{DynamicResource PromptText}" Margin="0,16,0,0" />
            </StackPanel>
        </ScrollViewer>
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="20,18,20,20">
            <StackPanel Orientation="Horizontal" Margin="0,0,8,0">
                <Button x:Name="ResumeButton" Click="Resume_Click" Style="{StaticResource ResumeGo}" />
                <Border Width="1" Background="{DynamicResource UiGoText}" Opacity="0.35" />
                <Button x:Name="ResumeMenuButton" Content="▾" Style="{StaticResource ResumeMenuPart}" Click="ResumeMenuButton_Click"
                        ToolTip="Resume options: preview or copy the prompt, or start in another platform (summary only)" AutomationProperties.Name="Resume options">
                    <Button.ContextMenu>
                        <ContextMenu x:Name="ResumeMenu" Placement="Bottom" HorizontalOffset="-150" MinWidth="200">
                            <MenuItem x:Name="PreviewItem" Header="Preview the prompt…" Click="PreviewItem_Click"
                                      ToolTipService.ShowOnDisabled="True" />
                            <MenuItem x:Name="CopyItem" Header="Copy the prompt" Click="CopyItem_Click"
                                      ToolTipService.ShowOnDisabled="True" />
                            <Separator />
                            <!-- The platform the new session starts in (RS-D2, RS-D3): the items are on in a summary only. Each names its platform as its header. -->
                            <MenuItem x:Name="TargetClaudeItem" Click="TargetItem_Click" IsCheckable="True" ToolTipService.ShowOnDisabled="True" />
                            <MenuItem x:Name="TargetCodexItem" Click="TargetItem_Click" IsCheckable="True" ToolTipService.ShowOnDisabled="True" />
                            <MenuItem x:Name="TargetCopilotItem" Click="TargetItem_Click" IsCheckable="True" ToolTipService.ShowOnDisabled="True" />
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>
            </StackPanel>
            <Button Content="Cancel" IsCancel="True" IsDefault="True" Click="Cancel_Click" Margin="0" />
        </StackPanel>
    </Grid>
</Window>
